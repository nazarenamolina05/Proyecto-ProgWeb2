<main class="perfil">
    {{#error}}
        <div class="grammys-error">
            <p>{{error}}</p>
        </div>
    {{/error}}

    {{^error}}
        <section class="perfil-card perfil-cabecera">
            <div class="perfil-avatar">
                {{#foto}}
                    <img src="{{base}}/public/uploads/perfiles/{{foto}}" alt="Foto de perfil de {{usuario}}">
                {{/foto}}
                {{^foto}}
                    <span aria-hidden="true">♪</span>
                {{/foto}}
            </div>

            <div class="perfil-titulo">
                <h1>{{nombre_completo}}</h1>
                <p class="perfil-usuario">@{{usuario}}</p>
                {{#es_propio}}
                    <a href="{{url_editar}}" class="grammys-button">Editar mi perfil</a>
                {{/es_propio}}
            </div>

            <div class="perfil-stats">
                <div class="perfil-stat">
                    <strong>{{puntaje_total}}</strong>
                    <span>Puntaje total</span>
                </div>
                <div class="perfil-stat">
                    <strong>{{partidas_jugadas}}</strong>
                    <span>Partidas realizadas</span>
                </div>
            </div>
        </section>

        <section class="perfil-card">
            <h2>Datos personales</h2>
            <dl class="perfil-datos">
                <div>
                    <dt>Nombre</dt>
                    <dd>{{nombre_completo}}</dd>
                </div>
                <div>
                    <dt>Año de nacimiento</dt>
                    <dd>{{anio_nacimiento}}</dd>
                </div>
                <div>
                    <dt>Sexo</dt>
                    <dd>{{sexo}}</dd>
                </div>
                <div>
                    <dt>Ubicación</dt>
                    <dd>{{ciudad}}, {{pais}}</dd>
                </div>
            </dl>

            {{#mapa_url}}
                <iframe class="perfil-mapa" src="{{mapa_url}}" loading="lazy"
                        title="Mapa de ubicación del jugador"></iframe>
            {{/mapa_url}}
            {{^mapa_url}}
                <p class="perfil-vacio">Este jugador no cargó su ubicación.</p>
            {{/mapa_url}}
        </section>

        <section class="perfil-card">
            <h2>Código QR del perfil</h2>
            <div class="perfil-qr">
                <img src="{{qr_url}}" alt="Código QR para abrir el perfil de {{usuario}}" width="160" height="160">
                <p>Escaneá el código para abrir este perfil:<br>
                    <a href="{{url_perfil}}">{{url_perfil}}</a></p>
            </div>
        </section>

        <section class="perfil-card">
            <h2>Partidas jugadas</h2>
            {{#tiene_partidas}}
                <table class="perfil-tabla">
                    <tr>
                        <th>Fecha</th>
                        <th>Puntaje</th>
                    </tr>
                    {{#partidas}}
                        <tr>
                            <td>{{fecha_formateada}}</td>
                            <td>{{puntaje}}</td>
                        </tr>
                    {{/partidas}}
                </table>
            {{/tiene_partidas}}
            {{^tiene_partidas}}
                <p class="perfil-vacio">Este jugador todavía no jugó ninguna partida.</p>
            {{/tiene_partidas}}
        </section>
    {{/error}}
</main>