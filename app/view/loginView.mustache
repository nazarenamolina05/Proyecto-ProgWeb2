<main class="login-container">
    <section class="login-card">
        <p class="login-etiqueta">PREGUNTADOS MUSICAL</p>

        <h2>¡Que empiece el juego!</h2>

        <p class="login-descripcion">
            Ingresá a tu cuenta y demostrá cuánto sabés de música.
        </p>

        {{#error}}
            <p class="login-error">{{error}}</p>
        {{/error}}

        <form action="index.php?controller=login&amp;method=login" method="POST">
            <div class="login-campo">
                <label for="usuario">Nombre de usuario</label>
                <input
                    type="text"
                    id="usuario"
                    name="usuario"
                    autocomplete="username"
                    required
                >
            </div>

            <div class="login-campo">
                <label for="password">Contraseña</label>
                <input
                    type="password"
                    id="password"
                    name="password"
                    autocomplete="current-password"
                    required
                >
            </div>

            <button type="submit">INICIAR SESIÓN</button>
        </form>

        <p class="login-registro">
            ¿Todavía no tenés cuenta?
            <a href="index.php?controller=registro&amp;method=show">
                Registrate acá
            </a>
        </p>
    </section>
</main>
