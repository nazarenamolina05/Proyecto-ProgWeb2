<main class="editor-panel">
    <a href="{{base}}/index.php?controller=editor&amp;method=show&amp;seccion={{origen}}">Volver a {{origen}}</a>
    <section class="editor-seccion" aria-labelledby="titulo-editor">
        <h1 id="titulo-editor">{{titulo}}</h1>
        {{#error}}<p class="grammys-error" role="alert">{{error}}</p>{{/error}}
        <form class="editor-formulario" method="post" action="{{base}}/index.php?controller=editor&amp;method=guardar">
            <input type="hidden" name="token" value="{{token}}">
            <input type="hidden" name="id" value="{{id}}">
            <input type="hidden" name="origen" value="{{origen}}">

            <label for="editor-enunciado">Enunciado</label>
            <textarea id="editor-enunciado" name="enunciado" rows="3" maxlength="255" required>{{enunciado}}</textarea>

            <label for="editor-opcion-1">Opción 1</label>
            <input id="editor-opcion-1" name="opcion_1" value="{{opcion_1}}" maxlength="150" required>
            <label for="editor-opcion-2">Opción 2</label>
            <input id="editor-opcion-2" name="opcion_2" value="{{opcion_2}}" maxlength="150" required>
            <label for="editor-opcion-3">Opción 3</label>
            <input id="editor-opcion-3" name="opcion_3" value="{{opcion_3}}" maxlength="150" required>

            <label for="editor-correcta">Respuesta correcta</label>
            <select id="editor-correcta" name="correcta" required>
                <option value="">Elegí una opción</option>
                <option value="1" {{#correcta_1}}selected{{/correcta_1}}>Opción 1</option>
                <option value="2" {{#correcta_2}}selected{{/correcta_2}}>Opción 2</option>
                <option value="3" {{#correcta_3}}selected{{/correcta_3}}>Opción 3</option>
            </select>

            <label for="editor-categoria">Categoría</label>
            <select id="editor-categoria" name="categoria_id" required>
                <option value="">Elegí una categoría</option>
                {{#categorias}}<option value="{{id}}" {{#seleccionada}}selected{{/seleccionada}}>{{nombre}}</option>{{/categorias}}
            </select>

            <label for="editor-dificultad">Dificultad</label>
            <select id="editor-dificultad" name="dificultad" required>
                {{#dificultades}}<option value="{{valor}}" {{#seleccionada}}selected{{/seleccionada}}>{{nombre}}</option>{{/dificultades}}
            </select>

            <label for="editor-imagen">URL de la imagen (opcional)</label>
            <input id="editor-imagen" type="url" name="imagen" value="{{imagen}}" maxlength="500" placeholder="https://">

            <button type="submit" class="grammys-button">Guardar pregunta</button>
        </form>
    </section>
</main>
