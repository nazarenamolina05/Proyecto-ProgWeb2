
<main class="contenedor grammys-register">

    <p class="grammys-eyebrow">Únete a la comunidad</p>
    <h1>Crear tu cuenta</h1>

    <p class="descripcion">
        Regístrate para empezar a jugar y poner a prueba tus conocimientos musicales.
    </p>

    {{#error}}
        <p class="mensaje error" role="alert">{{error}}</p>
    {{/error}}

    <form action="/Proyecto-ProgWeb2/index.php?controller=registro&amp;method=registrar"
          method="POST">

        <div class="campo">
            <label for="usuario">Nombre de usuario</label>

            <input
                type="text"
                id="usuario"
                name="usuario"
                value="{{usuario}}"
                minlength="3"
                maxlength="50"
                pattern="[a-zA-Z0-9_]{3,50}"
                title="Entre 3 y 50 letras sin acentos, números o guion bajo."
                autocomplete="username"
                required
            >
        </div>

        <div class="campo">
            <label for="password">Contraseña</label>

            <input
                type="password"
                id="password"
                name="password"
                minlength="8"
                autocomplete="new-password"
                required
            >
        </div>

        <div class="campo">
            <label for="confirmar_password">
                Repetir contraseña
            </label>

            <input
                type="password"
                id="confirmar_password"
                name="confirmar_password"
                minlength="8"
                autocomplete="new-password"
                required
            >
        </div>

        <button type="submit">Registrarme</button>

    </form>

    <p class="login">
        ¿Ya tenés cuenta?
        <a href="/Proyecto-ProgWeb2/#acceso">Iniciar sesión</a>
    </p>

</main>