<main class="partida-contenedor">
    <section class="partida-tarjeta" aria-labelledby="partida-titulo">
        <p class="grammys-eyebrow">The Grammys Trivia</p>

        <h1 id="partida-titulo">
            {{#elegir_categoria}}
                Elegí una categoría
            {{/elegir_categoria}}

            {{^elegir_categoria}}
                Tu desafío musical
            {{/elegir_categoria}}
        </h1>

        {{#categoria_nombre}}
            <p>
                Categoría:
                <strong>{{categoria_nombre}}</strong>
            </p>
        {{/categoria_nombre}}

        {{#error}}
            <p class="grammys-error" role="alert">
                {{error}}
            </p>
        {{/error}}

        {{#elegir_categoria}}
            <p>Elegí tu tema y poné a prueba cuánto sabés de música.</p>

            <form
                method="post"
                action="{{base}}/index.php?controller=partida&amp;method=elegirCategoria"
            >
                <input type="hidden" name="token" value="{{token}}">

                <fieldset class="partida-opciones">
                    <legend>Categorías disponibles</legend>

                    {{#categorias}}
                        <label class="partida-opcion">
                            <input
                                type="radio"
                                name="categoria_id"
                                value="{{id}}"
                                required
                            >

                            <span>{{nombre}}</span>
                        </label>
                    {{/categorias}}
                </fieldset>

                {{#hay_categorias}}
                    <button class="grammys-button" type="submit">
                        Empezar a jugar
                    </button>
                {{/hay_categorias}}

                {{^categorias}}
                    <p>Todavía no hay categorías disponibles.</p>
                {{/categorias}}
            </form>
        {{/elegir_categoria}}

        {{#sin_preguntas}}
            <p>
                Todavía no hay preguntas disponibles en esta categoría.
                Elegí otra categoría para jugar.
            </p>
        {{/sin_preguntas}}

        {{#imagen}}
            <img
                class="partida-imagen"
                src="{{imagen}}"
                alt="Portada del álbum que debés identificar"
                referrerpolicy="no-referrer"
            >
        {{/imagen}}

        {{#en_curso}}
            <p>Elegí una opción y confirmá tu respuesta.</p>

            <form
                method="post"
                action="{{base}}/index.php?controller=partida&amp;method=responder"
            >
                <input type="hidden" name="token" value="{{token}}">

                <fieldset class="partida-opciones">
                    <legend>{{pregunta}}</legend>

                    {{#opciones}}
                        <label class="partida-opcion">
                            <input
                                type="radio"
                                name="respuesta"
                                value="{{id}}"
                                required
                            >

                            <span>{{texto}}</span>
                        </label>
                    {{/opciones}}
                </fieldset>

                <button class="grammys-button" type="submit">
                    Confirmar respuesta
                </button>
            </form>
        {{/en_curso}}

        {{#finalizada}}
            <h2>
                {{#correcta}}
                    ¡Respuesta correcta!
                {{/correcta}}

                {{^correcta}}
                    Esta vez no acertaste
                {{/correcta}}
            </h2>

            <p>{{pregunta}}</p>

            <p>
                Elegiste:
                <strong>{{respuesta_elegida}}</strong>.
            </p>

            {{^correcta}}
                <p>
                    La respuesta correcta es:
                    <strong>{{respuesta_correcta}}</strong>.
                </p>
            {{/correcta}}

            <form
                method="post"
                action="{{base}}/index.php?controller=partida&amp;method=comenzar"
            >
                <input type="hidden" name="token" value="{{token}}">

                <button class="grammys-button" type="submit">
                    Otra pregunta de esta categoría
                </button>
            </form>
        {{/finalizada}}

        {{^elegir_categoria}}
            <a
                class="partida-volver"
                href="{{base}}/index.php?controller=partida&amp;method=categorias"
            >
                Cambiar categoría
            </a>
        {{/elegir_categoria}}

        <a class="partida-volver" href="{{base}}/">
            Volver al inicio
        </a>
    </section>
</main>