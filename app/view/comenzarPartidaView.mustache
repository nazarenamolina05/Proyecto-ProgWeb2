
<main class="partida-contenedor">
    <section class="partida-tarjeta" aria-labelledby="partida-titulo">
        <p class="grammys-eyebrow">The Grammys Trivia</p>

        <h1 id="partida-titulo">
            {{#elegir_categoria}}
                Elegí una categoría
            {{/elegir_categoria}}

            {{^elegir_categoria}}
                Tu desafío musical
            {{/elegir_categoria}}
        </h1>

        {{#categoria_nombre}}
            <p>
                Categoría:
                <strong>{{categoria_nombre}}</strong>
            </p>

            <p>
                Dificultad:
                <strong>{{dificultad}}</strong>
            </p>

            <p>
                Respuestas correctas:
                <strong>{{correctas}} / {{total_preguntas}}</strong>
            </p>
        {{/categoria_nombre}}

        {{#mostrar_puntaje}}
            <p class="partida-puntaje">
                Puntaje:
                <strong>{{puntaje}}</strong>
            </p>
        {{/mostrar_puntaje}}

        {{#error}}
            <p class="grammys-error" role="alert">
                {{error}}
            </p>
        {{/error}}

        {{#mensaje}}
            <p role="status">
                {{mensaje}}
            </p>
        {{/mensaje}}

        <!-- ELEGIR CATEGORÍA Y DIFICULTAD -->

        {{#elegir_categoria}}
            <p>
                Elegí tu tema y poné a prueba
                cuánto sabés de música.
            </p>

            <form
                method="post"
                action="{{base}}/index.php?controller=partida&amp;method=elegirCategoria"
            >
                <input
                    type="hidden"
                    name="token"
                    value="{{token}}"
                >

                <fieldset class="partida-opciones">
                    <legend>Categorías disponibles</legend>

                    {{#categorias}}
                        <label class="partida-opcion">
                            <input
                                type="radio"
                                name="categoria_id"
                                value="{{id}}"
                                required
                            >
                            <span>{{nombre}}</span>
                        </label>
                    {{/categorias}}
                </fieldset>

                <fieldset class="partida-opciones">
                    <legend>Elegí la dificultad</legend>

                    <label class="partida-opcion">
                        <input
                            type="radio"
                            name="dificultad"
                            value="FACIL"
                            required
                        >
                        <span>Fácil</span>
                    </label>

                    <label class="partida-opcion">
                        <input
                            type="radio"
                            name="dificultad"
                            value="INTERMEDIO"
                            checked
                        >
                        <span>Intermedio</span>
                    </label>

                    <label class="partida-opcion">
                        <input
                            type="radio"
                            name="dificultad"
                            value="DIFICIL"
                        >
                        <span>Difícil</span>
                    </label>
                </fieldset>

                {{#hay_categorias}}
                    <button
                        class="grammys-button"
                        type="submit"
                    >
                        Empezar a jugar
                    </button>
                {{/hay_categorias}}

                {{^categorias}}
                    <p>
                        Todavía no hay categorías disponibles.
                    </p>
                {{/categorias}}
            </form>
        {{/elegir_categoria}}

        <!-- SIN PREGUNTAS -->

        {{#sin_preguntas}}
            <p>
                Todavía no hay preguntas disponibles
                en esta categoría.
                Elegí otra categoría para jugar.
            </p>
        {{/sin_preguntas}}
        {{#derrota}}
            <div class="derrota-fondo">
                <section
                        class="popup-derrota"
                        role="dialog"
                        aria-modal="true"
                        aria-labelledby="titulo-derrota"
                >
                    <h2 id="titulo-derrota">Perdiste la partida</h2>

                    <p>Volviste a abrir el desafío y se descontó 1 punto.</p>

                    <p class="popup-derrota-puntaje">
                        Puntaje final
                        <strong>{{puntaje_final}}</strong>
                    </p>

                    {{#guardada}}
                        <p>Tu resultado quedó guardado en tu perfil.</p>
                    {{/guardada}}

                    {{^guardada}}
                        <p>Jugaste como invitado. Este resultado no se guardó.</p>
                    {{/guardada}}

                    <audio autoplay src="{{base}}/public/audio/respuesta-incorrecta.mp3"></audio>

                    <a
                            class="grammys-button"
                            href="{{base}}/index.php?controller=partida&amp;method=categorias"
                    >
                        Volver a jugar
                    </a>
                </section>
            </div>
        {{/derrota}}

        <!-- IMAGEN DE LA PREGUNTA -->

        {{#imagen}}
            <img
                class="partida-imagen"
                src="{{imagen}}"
                alt="Portada del álbum que debés identificar"
                referrerpolicy="no-referrer"
            >
        {{/imagen}}

        {{#en_curso}}
            <div class="partida-temporizador">
                <div
                    id="partida-tiempo"
                    class="partida-tiempo"
                    role="progressbar"
                    aria-label="Tiempo restante"
                    aria-valuemin="0"
                    aria-valuemax="{{duracion_pregunta}}"
                    aria-valuenow="{{segundos_restantes}}"
                    aria-valuetext="{{segundos_restantes}} segundos"
                >
                    <div class="partida-tiempo-pista" aria-hidden="true">
                        <div class="partida-tiempo-barra">
                            <img
                                class="partida-tiempo-grammy"
                                src="{{base}}/public/images/grammy-award.png"
                                alt=""
                            >
                        </div>
                    </div>
                </div>
                <button
                    id="partida-sonido"
                    class="grammys-button partida-sonido"
                    type="button"
                    aria-label="Sonido de la partida"
                    aria-pressed="false"
                >
                    <svg
                        aria-hidden="true"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M11 5 6 9H3v6h3l5 4Z" />
                        <path class="partida-sonido-ondas" d="M15 8a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14" />
                        <path class="partida-sonido-tachado" d="m3 3 18 18" />
                    </svg>
                </button>
            </div>
        {{/en_curso}}

        {{#audio_partida}}
            <audio
                id="partida-audio"
                src="{{base}}/public/audio/{{audio_partida}}"
                preload="auto"
                {{#en_curso}}loop{{/en_curso}}
            ></audio>
        {{/audio_partida}}

        <!-- PREGUNTA EN CURSO -->

        {{#en_curso}}
            <p>Elegí una opción y confirmá tu respuesta.</p>

            <form
                method="post"
                action="{{base}}/index.php?controller=partida&amp;method=responder"
            >
                <input
                    type="hidden"
                    name="token"
                    value="{{token}}"
                >

                <fieldset class="partida-opciones">
                    <legend>{{pregunta}}</legend>

                    {{#opciones}}
                        <label class="partida-opcion">
                            <input
                                type="radio"
                                name="respuesta"
                                value="{{id}}"
                                required
                            >

                            <span>{{texto}}</span>
                        </label>
                    {{/opciones}}
                </fieldset>

                <button
                    class="grammys-button"
                    type="submit"
                >
                    Confirmar respuesta
                </button>
            </form>

            <!-- TERMINAR PARTIDA MIENTRAS JUEGA -->

            <form
                class="partida-terminar-en-curso"
                method="post"
                action="{{base}}/index.php?controller=partida&amp;method=terminar"
            >
                <input
                    type="hidden"
                    name="token"
                    value="{{token}}"
                >

                <button
                    class="grammys-button"
                    type="submit"
                >
                    Terminar partida
                </button>
            </form>

            <!-- FORMULARIO AUTOMÁTICO POR TIEMPO AGOTADO -->

            <form
                id="partida-formulario-tiempo"
                method="post"
                action="{{base}}/index.php?controller=partida&amp;method=responder"
                hidden
            >
                <input
                    type="hidden"
                    name="token"
                    value="{{token}}"
                >

                <input
                    type="hidden"
                    name="tiempo_agotado"
                    value="1"
                >
            </form>

            <script>
                (function () {
                    const barra = document.getElementById('partida-tiempo');
                    const formulario = document.getElementById('partida-formulario-tiempo');
                    const audio = document.getElementById('partida-audio');
                    const duracion = {{duracion_pregunta}} * 1000;
                    const restanteInicial = {{milisegundos_restantes}};
                    const venceEn = performance.now() + restanteInicial;
                    let segundosVisibles = {{segundos_restantes}};
                    let fotograma;
                    let vencimiento;

                    function actualizarBarra(restante) {
                        const proporcion = Math.min(1, restante / duracion);
                        barra.style.setProperty('--tiempo-restante', (proporcion * 100) + '%');
                        const segundos = Math.ceil(restante / 1000);
                        if (segundos !== segundosVisibles) {
                            barra.setAttribute('aria-valuenow', segundos);
                            barra.setAttribute('aria-valuetext', segundos + ' segundos');
                            segundosVisibles = segundos;
                        }
                    }

                    function animarBarra() {
                        const restante = Math.max(0, venceEn - performance.now());
                        actualizarBarra(restante);
                        if (restante > 0) {
                            fotograma = requestAnimationFrame(animarBarra);
                        }
                    }

                    function detenerTemporizador() {
                        cancelAnimationFrame(fotograma);
                        clearTimeout(vencimiento);
                        audio.pause();
                    }

                    animarBarra();
                    vencimiento = setTimeout(() => {
                        actualizarBarra(0);
                        detenerTemporizador();
                        formulario.submit();
                    }, Math.max(0, venceEn - performance.now()));

                    barra.closest('.partida-tarjeta').addEventListener('submit', detenerTemporizador);
                    window.addEventListener('pagehide', detenerTemporizador);
                    window.addEventListener('pageshow', (evento) => {
                        if (evento.persisted) {
                            window.location.reload();
                        }
                    });
                }());
            </script>
        {{/en_curso}}

        <!-- RESULTADO DESPUÉS DE RESPONDER -->

        {{#finalizada}}

            <!-- SI SE TERMINÓ EL TIEMPO -->

            {{#agotado}}
                <h2>¡Se agotó el tiempo!</h2>

                <p>
                    No respondiste a tiempo
                    y se descontó un punto.
                </p>
            {{/agotado}}

            <!-- SI RESPONDIÓ -->

            {{^agotado}}
                <h2>
                    {{#correcta}}
                        ¡Respuesta correcta!
                    {{/correcta}}

                    {{^correcta}}
                        Esta vez no acertaste
                    {{/correcta}}
                </h2>
            {{/agotado}}

            <!-- PREGUNTA QUE ACABA DE TERMINAR -->

            <p>{{pregunta}}</p>

            {{^agotado}}
                <p>
                    Elegiste:
                    <strong>{{respuesta_elegida}}</strong>.
                </p>
            {{/agotado}}

            {{^correcta}}
                <p>
                    La respuesta correcta es:
                    <strong>{{respuesta_correcta}}</strong>.
                </p>
            {{/correcta}}

            <div class="partida-acciones">
                <form
                    method="post"
                    action="{{base}}/index.php?controller=partida&amp;method=terminar"
                >
                    <input type="hidden" name="token" value="{{token}}">
                    <button class="grammys-button partida-accion partida-accion-terminar" type="submit">
                        Terminar partida
                    </button>
                </form>

                <form
                    method="post"
                    action="{{base}}/index.php?controller=partida&amp;method=comenzar"
                >
                    <input type="hidden" name="token" value="{{token}}">
                    <button class="grammys-button partida-accion partida-accion-seguir" type="submit">
                        <span>Otra pregunta de esta categoría</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M3 12h17m-7-7 7 7-7 7" />
                        </svg>
                    </button>
                </form>
            </div>

            <div class="partida-contribuciones">
                <details>
                    <summary class="partida-contribucion partida-contribucion-reportar" aria-label="Reportar pregunta actual">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M4 22V3m0 1c5-4 10 4 16 0v10c-6 4-11-4-16 0" />
                        </svg>
                        Reportar
                    </summary>

                    <form
                        class="partida-reporte"
                        method="post"
                        action="{{base}}/index.php?controller=contribucion&amp;method=reportar"
                    >
                        <input
                            type="hidden"
                            name="token"
                            value="{{contribucion_token}}"
                        >

                        <input
                            type="hidden"
                            name="pregunta_id"
                            value="{{pregunta_id}}"
                        >

                        <label for="motivo-reporte">
                            Motivo del reporte (opcional)
                        </label>

                        <textarea
                            id="motivo-reporte"
                            name="motivo"
                            rows="3"
                            maxlength="500"
                            placeholder="Podés explicar qué tiene de malo esta pregunta, o dejarlo vacío."
                        ></textarea>

                        <button class="grammys-button" type="submit">
                            Enviar reporte
                        </button>
                    </form>
                </details>

                <a
                    class="partida-contribucion"
                    href="{{base}}/index.php?controller=contribucion&amp;method=sugerir"
                >
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M9 18h6m-5 3h4m-6-8a7 7 0 1 1 8 0c-1 .8-1 1.5-1 3h-6c0-1.5 0-2.2-1-3Z" />
                    </svg>
                    Sugerencia
                </a>

            </div>

        {{/finalizada}}

        {{#audio_partida}}
            <script>
                (function () {
                    const audio = document.getElementById('partida-audio');
                    const boton = document.getElementById('partida-sonido');
                    const claveSilencio = 'partida-musica-silenciada';

                    function reproducirSonido() {
                        audio.play().then(() => {
                            if (!audio.paused) {
                                boton?.setAttribute('aria-pressed', 'true');
                            }
                        }).catch(() => {
                            boton?.setAttribute('aria-pressed', 'false');
                        });
                    }

                    audio.volume = audio.loop ? 0.35 : 0.65;
                    boton?.addEventListener('click', () => {
                        if (!audio.paused || boton.getAttribute('aria-pressed') === 'true') {
                            audio.pause();
                            boton.setAttribute('aria-pressed', 'false');
                            sessionStorage.setItem(claveSilencio, '1');
                        } else {
                            reproducirSonido();
                            sessionStorage.removeItem(claveSilencio);
                        }
                    });

                    if (!sessionStorage.getItem(claveSilencio)) {
                        reproducirSonido();
                    }
                }());
            </script>
        {{/audio_partida}}

        <!-- CAMBIAR CATEGORÍA -->

        {{^elegir_categoria}}
            <a
                class="partida-volver"
                href="{{base}}/index.php?controller=partida&amp;method=categorias"
            >
                Cambiar categoría
            </a>
        {{/elegir_categoria}}

        <!-- VOLVER AL INICIO -->

        <a
            class="partida-volver"
            href="{{base}}/"
        >
            Volver al inicio
        </a>

    </section>
</main>
