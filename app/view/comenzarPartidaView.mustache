<main class="partida-contenedor">
    <section class="partida-tarjeta" aria-labelledby="partida-titulo">
        <p class="grammys-eyebrow">The Grammys Trivia</p>

        <h1 id="partida-titulo">
            {{#elegir_categoria}}
                Elegí una categoría
            {{/elegir_categoria}}

            {{^elegir_categoria}}
                Tu desafío musical
            {{/elegir_categoria}}
        </h1>

        {{#categoria_nombre}}
    <p>
        Categoría:
        <strong>{{categoria_nombre}}</strong>
    </p>

    <p>
        Dificultad:
        <strong>{{dificultad}}</strong>
    </p>

    <p>
        Respuestas correctas:
        <strong>{{correctas}} / {{total_preguntas}}</strong>
    </p>
{{/categoria_nombre}}

        {{#mostrar_puntaje}}
            <p class="partida-puntaje">
                Puntaje:
                <strong>{{puntaje}}</strong>
            </p>
        {{/mostrar_puntaje}}

        {{#error}}
            <p class="grammys-error" role="alert">
                {{error}}
            </p>
        {{/error}}

        {{#mensaje}}
    <p role="status">
        {{mensaje}}
    </p>
{{/mensaje}}

        {{#elegir_categoria}}
            <p>Elegí tu tema y poné a prueba cuánto sabés de música.</p>

            <form
                method="post"
                action="{{base}}/index.php?controller=partida&amp;method=elegirCategoria"
            >
                <input type="hidden" name="token" value="{{token}}">

                <fieldset class="partida-opciones">
                    <legend>Categorías disponibles</legend>

                    {{#categorias}}
                        <label class="partida-opcion">
                            <input
                                type="radio"
                                name="categoria_id"
                                value="{{id}}"
                                required
                            >

                            <span>{{nombre}}</span>
                        </label>
                    {{/categorias}}
                </fieldset>
    <legend>Elegí la dificultad</legend>

    <label class="partida-opcion">
        <input type="radio" name="dificultad" value="FACIL" required>
        <span>Fácil</span>
    </label>

    <label class="partida-opcion">
        <input type="radio" name="dificultad" value="INTERMEDIO" checked>
        <span>Intermedio</span>
    </label>

    <label class="partida-opcion">
        <input type="radio" name="dificultad" value="DIFICIL">
        <span>Difícil</span>
    </label>
</fieldset>


                {{#hay_categorias}}
                    <button class="grammys-button" type="submit">
                        Empezar a jugar
                    </button>
                {{/hay_categorias}}

                {{^categorias}}
                    <p>Todavía no hay categorías disponibles.</p>
                {{/categorias}}
            </form>
        {{/elegir_categoria}}

        {{#sin_preguntas}}
            <p>
                Todavía no hay preguntas disponibles en esta categoría.
                Elegí otra categoría para jugar.
            </p>
        {{/sin_preguntas}}

        {{#imagen}}
            <img
                class="partida-imagen"
                src="{{imagen}}"
                alt="Portada del álbum que debés identificar"
                referrerpolicy="no-referrer"
            >
        {{/imagen}}

        {{#en_curso}}
            <p class="partida-tiempo" role="timer" aria-label="Tiempo restante">
                Tiempo restante:
                <strong id="partida-segundos">{{segundos_restantes}}</strong>
                segundos
            </p>

            <p>Elegí una opción y confirmá tu respuesta.</p>

            <form
                method="post"
                action="{{base}}/index.php?controller=partida&amp;method=responder"
            >
                <input type="hidden" name="token" value="{{token}}">

                <fieldset class="partida-opciones">
                    <legend>{{pregunta}}</legend>

                    {{#opciones}}
                        <label class="partida-opcion">
                            <input
                                type="radio"
                                name="respuesta"
                                value="{{id}}"
                                required
                            >

                            <span>{{texto}}</span>
                        </label>
                    {{/opciones}}
                </fieldset>

                <button class="grammys-button" type="submit">
                    Confirmar respuesta
                </button>
            </form>
            <form
    method="post"
    action="{{base}}/index.php?controller=partida&amp;method=terminar"
>
    <input type="hidden" name="token" value="{{token}}">

    <button class="grammys-button" type="submit">
        Terminar partida
    </button>
</form>

            <form
                id="partida-formulario-tiempo"
                method="post"
                action="{{base}}/index.php?controller=partida&amp;method=responder"
                hidden
            >
                <input type="hidden" name="token" value="{{token}}">
                <input type="hidden" name="tiempo_agotado" value="1">
            </form>

            <script>
                (function () {
                    var contador = document.getElementById('partida-segundos');
                    var formulario = document.getElementById('partida-formulario-tiempo');
                    var intervalo;
                    var venceEn = window.performance.now() + {{milisegundos_restantes}};

                    function enviarAlAgotarse() {
                        window.clearInterval(intervalo);
                        formulario.submit();
                    }

                    function actualizarContador() {
                        var milisegundosRestantes =
                            venceEn - window.performance.now();

                        contador.textContent = Math.max(
                            0,
                            Math.ceil(milisegundosRestantes / 1000)
                        );

                        if (milisegundosRestantes <= 0) {
                            enviarAlAgotarse();
                        }
                    }

                    if ({{milisegundos_restantes}} <= 0) {
                        enviarAlAgotarse();
                        return;
                    }

                    intervalo = window.setInterval(actualizarContador, 100);
                    actualizarContador();
                }());
            </script>
        {{/en_curso}}

        {{#finalizada}}
            {{#agotado}}
                <h2>¡Se agotó el tiempo!</h2>
                <p>No respondiste a tiempo y se descontó un punto.</p>
            {{/agotado}}

            {{^agotado}}
                <h2>
                    {{#correcta}}
                        ¡Respuesta correcta!
                    {{/correcta}}

                    {{^correcta}}
                        Esta vez no acertaste
                    {{/correcta}}
                </h2>

                <p>{{pregunta}}</p>

                <p>
                    Elegiste:
                    <strong>{{respuesta_elegida}}</strong>.
                </p>
            {{/agotado}}

            {{^correcta}}
                <p>
                    La respuesta correcta es:
                    <strong>{{respuesta_correcta}}</strong>.
                </p>
            {{/correcta}}
            <form
    method="post"
    action="{{base}}/index.php?controller=partida&amp;method=terminar"
>
    <input type="hidden" name="token" value="{{token}}">

    <button class="grammys-button" type="submit">
        Terminar partida
    </button>
</form>

            <form
                method="post"
                action="{{base}}/index.php?controller=partida&amp;method=comenzar"
            >
                <input type="hidden" name="token" value="{{token}}">

                <button class="grammys-button" type="submit">
                    Otra pregunta de esta categoría
                </button>
            </form>
        {{/finalizada}}

        {{^elegir_categoria}}
            <a
                class="partida-volver"
                href="{{base}}/index.php?controller=partida&amp;method=categorias"
            >
                Cambiar categoría
            </a>
        {{/elegir_categoria}}

        <a class="partida-volver" href="{{base}}/">
            Volver al inicio
        </a>
    </section>
</main>